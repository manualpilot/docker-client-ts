{
  "name": "docker-client-ts",
  "description": "Client for the Docker Engine API with a fluent interface and strong typings, derived from the official schema",
  "version": "0.0.21",
  "homepage": "https://github.com/manualpilot/docker-client-ts",
  "repository": "github:manualpilot/docker-client-ts",
  "keywords": [
    "docker",
    "client",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "package.json",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "prebuild": "rm -rf ./dist ./*.tsbuildinfo",
    "build": "tsc --project tsconfig-build.json",
    "postbuild": "tsc-alias --project tsconfig-build.json",
    "format": "biome check --verbose --write --unsafe",
    "generate": "node ./generator/generate.mjs",
    "postgenerate": "npm run format",
    "test": "tsc --project tsconfig-test.json && vitest run",
    "prepare": "husky",
    "upgrade": "ncu --interactive --install always"
  },
  "dependencies": {
    "ix": "^7.0.0",
    "json-schema-to-ts": "^3.1.1",
    "npm-check-updates": "^18.0.1",
    "rxjs": "^7.8.2",
    "ssh2": "^1.16.0",
    "undici": "^7.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^13.0.3",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.30",
    "@types/ssh2": "^1.15.5",
    "husky": "^9.1.7",
    "semver": "^7.7.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.8.0"
  }
}
