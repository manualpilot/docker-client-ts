{
  "compilerOptions": {
    "declaration": true,
    "rootDir": ".",
    "sourceMap": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // import siblings by their real on-disk name ("./etc.ts"); tsc rewrites the
    // extension to ".js" on emit, so the shipped JS stays valid Node ESM
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ESNext"
    ]
  },
  "exclude": [],
  "include": [
    "src"
  ]
}
